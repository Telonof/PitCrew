<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PitCrew.ViewModels"
        x:Class="PitCrew.Views.ModWindow"
        x:DataType="vm:ModWindowViewModel"
        Title="{Binding Source='modedit.title', Converter={StaticResource Translatable}}"
        MinWidth="362"
        MinHeight="470"
        MaxWidth="362"
        MaxHeight="470"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Verdana" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Width" Value="200" />
        </Style>
    </Window.Styles>

    <Grid>
        <TextBlock Name="CreateLabel" Text="{Binding Source='modedit.header', Converter={StaticResource Translatable}}" HorizontalAlignment="Center" FontSize="20" Margin="0,10,0,0" />

        <StackPanel Spacing="38" HorizontalAlignment="Center" Margin="0,60,0,0">
            <TextBlock Text="{Binding Source='modedit.id', Converter={StaticResource Translatable}}" Margin="-30,0,0,0" Classes="rtlm"/>
            <TextBlock Text="{Binding Source='modedit.mod-title', Converter={StaticResource Translatable}}" Margin="-30,0,0,0" Classes="rtlm"/>
            <TextBlock Text="{Binding Source='modedit.author', Converter={StaticResource Translatable}}" Margin="-30,0,0,0" Classes="rtlm"/>
            <TextBlock Text="{Binding Source='modedit.version', Converter={StaticResource Translatable}}" Margin="-30,0,0,0" Classes="rtlm"/>
            <TextBlock Text="{Binding Source='modedit.desc', Converter={StaticResource Translatable}}" Margin="-50,0,0,0" Classes="rtlm"/>
            <Button Name="SubmitButton" HorizontalAlignment="Center" Width="110" Height="50" Content="{Binding ButtonText}" IsDefault="True" Command="{Binding Submit}" Margin="0,40,0,0"/>
        </StackPanel>

        <StackPanel Spacing="30" HorizontalAlignment="Center" Margin="0,80,0,0">
            <TextBox Text="{Binding Id}" IsEnabled="{Binding IdTextBoxEnabled}" />
            <TextBox Text="{Binding Name}" Classes="rtl"/>
            <TextBox Text="{Binding Author}" Classes="rtl"/>
            
            <Grid HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/> 
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
               
                <TextBox Grid.Column="0" Width="5" Text="{Binding MajorRev}" MaxLength="4" TextAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="." HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                <TextBox Grid.Column="2" Width="5" Text="{Binding MinorRev}" MaxLength="4" TextAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="." HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                <TextBox Grid.Column="4" Width="5" Text="{Binding BuildRev}" MaxLength="4" TextAlignment="Center"/>
            </Grid>
            
            <TextBox Name="DescriptionTextbox" Width="250" MinHeight="60" TextWrapping="Wrap" Text="{Binding Description}" Classes="rtl" AcceptsReturn="true"/>
        </StackPanel>
    </Grid>

</Window>