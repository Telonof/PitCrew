<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:behaviors="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Xaml.Behaviors"
        xmlns:vm="using:PitCrew.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PitCrew.Views.MessageBox"
        x:DataType="vm:MessageBoxViewModel"
        Title="{Binding Source='messagebox-title-default', Converter={StaticResource Translatable}}"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        MinWidth="150">

    <StackPanel Margin="0,10,0,0">
        <TextBlock Name="InfoText" Text="{Binding Message}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,10,30,10" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
            <Button Name="ConfirmButton" IsDefault="True" MinWidth="90" MinHeight="50" Margin="10" Command="{Binding Confirm}" IsVisible="{Binding OkVisible}">
	            <Viewbox Stretch="Uniform">
		            <TextBlock Text="{Binding OkButtonText}" />
	            </Viewbox>
            </Button>
            <Button Name="CancelButton" IsCancel="True" MinWidth="90" MinHeight="50" Margin="10" Command="{Binding Cancel}" IsVisible="{Binding CancelVisible}">
	            <Viewbox Stretch="Uniform">
		            <TextBlock Text="{Binding CancelButtonText}" />
	            </Viewbox>
            </Button>
        </StackPanel>
    </StackPanel>

	<Interaction.Behaviors>
		<EventTrigger EventName="Closing">
			<InvokeCommandAction Command="{Binding OnClose}" PassEventArgsToCommand="True"/>
		</EventTrigger>
	</Interaction.Behaviors>

</Window>